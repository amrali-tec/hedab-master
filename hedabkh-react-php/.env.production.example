# ==============================================================================
# GULF HILLS CONTRACTING — VISUAL CMS & PORTAL PRODUCTION ENVIRONMENT CONFIG
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. RUNTIME & HOSTING (REQUIRED)
# ------------------------------------------------------------------------------
# Node Environment ('production' for live deployment)
NODE_ENV=production

# The port the Next.js production server should bind to (Default: 3000)
PORT=3000

# Hostname to bind to ('0.0.0.0' for Docker/Cloud, 'localhost' for local reverse proxy)
HOSTNAME=0.0.0.0

# ------------------------------------------------------------------------------
# 2. APPLICATION URLS (REQUIRED)
# ------------------------------------------------------------------------------
# The canonical public URL of the deployed application (No trailing slash)
# Example: https://hedabkh.com.sa
NEXT_PUBLIC_APP_URL=https://hedabkh.com.sa

# ------------------------------------------------------------------------------
# 3. SECURITY & AUTHENTICATION (SERVER ONLY)
# ------------------------------------------------------------------------------
# Secret key used for signing session tokens and administrative cookies
# Generate a strong 64-character random string (e.g. openssl rand -hex 32)
ADMIN_SESSION_SECRET=

# ------------------------------------------------------------------------------
# 4. PERSISTENT STORAGE PATHS (OPTIONAL / PRODUCTION DEFAULTS)
# ------------------------------------------------------------------------------
# When deployed on Docker or VPS, ensure persistent volume mounts for:
# - data/ (CMS database & version snapshots)
# - public/uploads/ (Uploaded media, certificates, and portfolio images)
# ==============================================================================
